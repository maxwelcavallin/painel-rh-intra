# ---------------------------------------------------------------
# Banco — Neon (criado via Vercel: Storage > Add Database > Neon).
# Localmente: `vercel env pull .env.local` traz esta variável pronta.
# ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------
# Auth.js — gere com: openssl rand -base64 32
# ---------------------------------------------------------------
AUTH_SECRET=""
# Em produção a Vercel define AUTH_URL sozinha. Local, deixe assim:
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------
# IA — agente que julga a solicitação de férias
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------
# Canais de notificação
# ---------------------------------------------------------------
# Zaia: POST sem autenticação, payload com `telefone`.
# Dois eventos distintos = dois webhooks distintos na Zaia.
# Geral: decisão de férias, avisos do RH, lembrete de formulário.
ZAIA_WEBHOOK_URL=""
# Recuperação de senha: recebe `telefone` + `codigo`.
ZAIA_PASSWORD_RESET_WEBHOOK_URL=""

# Discord: canal fixo, para os AVISOS GERAIS do RH (Fase 3).
# Webhook não envia mensagem privada — DM para o gestor está no roadmap
# pós-entrega e exigiria um bot com token próprio.
DISCORD_WEBHOOK_URL=""

# ---------------------------------------------------------------
# Vercel Cron — protege a rota agendada de lembrete de formulários
# ---------------------------------------------------------------
CRON_SECRET=""
