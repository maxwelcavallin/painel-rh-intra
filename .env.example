# ---------------------------------------------------------------
# Banco — Neon (criado via Vercel: Storage > Add Database > Neon).
# Localmente: `vercel env pull .env.local` traz esta variável pronta.
# ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------
# Auth.js — gere com: openssl rand -base64 32
# ---------------------------------------------------------------
AUTH_SECRET=""
# Em produção a Vercel define AUTH_URL sozinha. Local, deixe assim:
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------
# IA — agente que julga a solicitação de férias
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------
# Zaia (WhatsApp) — UM WEBHOOK POR TEMPLATE.
#
# Na Zaia cada webhook está amarrado a um evento/template do agente, então
# mandar decisão de férias pelo webhook de senha entregaria a mensagem errada.
# Cada variável abaixo corresponde a um template distinto.
#
# Enquanto uma delas estiver vazia, o envio cai em ZAIA_WEBHOOK_URL (genérica)
# se ela existir; senão o envio é ignorado e registrado no log. Dá para
# configurar os templates aos poucos.
# ---------------------------------------------------------------
# Código de recuperação de senha. Recebe também `codigo`.
ZAIA_WEBHOOK_PASSWORD_RESET=""
# Férias aprovadas ou reprovadas → colaborador.
ZAIA_WEBHOOK_VACATION_DECISION=""
# Nova solicitação de férias → gestor direto.
ZAIA_WEBHOOK_VACATION_REQUEST=""
# Avisos do RH → audiência escolhida.
ZAIA_WEBHOOK_BROADCAST=""
# Cobrança de formulário pendente → gestor, consolidada.
ZAIA_WEBHOOK_FORM_REMINDER=""
# Fallback opcional, usado só quando o template acima está vazio.
ZAIA_WEBHOOK_URL=""

# ---------------------------------------------------------------
# Discord — canal fixo, para os AVISOS GERAIS do RH.
# Webhook não envia mensagem privada; DM para o gestor está no roadmap.
# ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=""

# ---------------------------------------------------------------
# Vercel Cron — protege a rota agendada de lembrete de formulários
# ---------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------
# Senhas de demonstração e da equipe de teste.
#
# NÃO ficam no código: o repositório é público e estas contas dão acesso real
# ao sistema — a de RH é admin master e enxerga CPF, RG e endereço de todos.
# `npm run db:seed` e `npm run db:equipe` falham alto se faltar alguma.
# ---------------------------------------------------------------
SEED_SENHA_ADMIN=""
SEED_SENHA_GESTOR=""
SEED_SENHA_USER=""
EQUIPE_SENHA_RH=""
EQUIPE_SENHA_MAXWEL=""
EQUIPE_SENHA_THAYLA=""
EQUIPE_SENHA_RAFAELA=""
EQUIPE_SENHA_KAMILLY=""
EQUIPE_SENHA_KAUAN=""
