# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o modelo, que é justamente o que o README manda copiar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# log do dev server iniciado destacado
dev-server.log

# Linhas abaixo acrescentadas pelo `vercel link`. Já estão cobertas acima; a
# reafirmação de `.env*` no fim anulava a exceção do .env.example, porque no
# gitignore a ÚLTIMA regra que casa é a que vale. Exceção reposta ao final.
.vercel
.env*
!.env.example

# Acessos de teste em texto puro — nunca versionar (repositório público).
docs/ACESSOS.local.md
